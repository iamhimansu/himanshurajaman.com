# Content source: "github" (production) or "local" (development).
CONTENT_SOURCE=local

# --- local source (CONTENT_SOURCE=local) ---
# Path to a directory laid out like the content repo (posts/, resume/, settings/, images/).
CONTENT_LOCAL_DIR=./sample-content

# --- github source (CONTENT_SOURCE=github) ---
# Fine-grained PAT with Contents: Read AND Write on the content repo only
# (Write is required once the admin/CMS block below is enabled). Sensitive.
# GITHUB_TOKEN=github_pat_xxxxxxxx
# Content repo in "owner/repo" form.
# CONTENT_REPO=iamhimansu/content.himanshurajaman.com
# Branch to ingest and write to (default: main).
# CONTENT_REF=main
# Optional push-to-resync webhook. Set the SAME secret on the content repo's
# GitHub webhook (content-type: application/json; event: push). Empty = the
# POST /webhook/github endpoint is disabled (404). Sensitive: never logged.
# GITHUB_WEBHOOK_SECRET=

# HTTP port (default: 8080).
PORT=8080

# Optional override of the SQLite temp-file path.
# SQLITE_PATH=/tmp/portfolio-v1.sqlite

# --- admin / CMS (optional: omit the whole block to run public-only) ---
# All four of GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ADMIN_EMAIL and
# SESSION_SECRET must be set together to enable admin. Setting some but not all
# fails fast at boot. GitHub-backed writes additionally require
# CONTENT_SOURCE=github (local content is read-only in the admin UI).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx            # sensitive
# ADMIN_EMAIL=you@example.com           # the ONLY Google account allowed to sign in
# SESSION_SECRET=                       # >=32 bytes; generate: openssl rand -base64 48 (sensitive)
# COOKIE_SECURE=false                   # true in production (HTTPS), false for http://localhost
# BASE_URL=http://localhost:8080        # used to derive the OAuth redirect if GOOGLE_REDIRECT_URL is unset
# GOOGLE_REDIRECT_URL=                  # optional explicit override of BASE_URL + /auth/callback

# --- contact form / SMTP (optional: omit to disable the public contact form) ---
# Fail-safe like the admin block: the public POST /api/contact endpoint and the
# home-page form are enabled ONLY when all of SMTP_HOST, SMTP_USERNAME and
# SMTP_PASSWORD are set. With any of them unset the endpoint returns 503 and the
# site shows a mailto: fallback instead of the form.
# Mail is sent over SMTP with STARTTLS; swap the Mailer implementation (see
# internal/contact) for an HTTP email API if your host blocks outbound SMTP.
# NOTE: verify your deploy host allows OUTBOUND SMTP. Render's free tier may
# block outbound ports 587/465; if so the form submit will fail — switch the
# Mailer to an HTTP email API (e.g. a transactional email provider). The mailto
# fallback keeps the Contact section usable in the meantime.
# Option A (recommended; works on Render free, which blocks outbound SMTP):
# RESEND_API_KEY=re_xxxxxxxx            # Resend HTTP API key; CONTACT_FROM must
#                                       # be an address on a Resend-verified domain
# Option B (SMTP; blocked on Render free):
# SMTP_HOST=smtp.example.com            # e.g. smtp.gmail.com
# SMTP_PORT=587                         # default 587 (submission + STARTTLS)
# SMTP_USERNAME=you@example.com         # SMTP login
# SMTP_PASSWORD=                        # SMTP password / app password (sensitive)
# CONTACT_TO=you@example.com            # recipient; falls back to ADMIN_EMAIL
# CONTACT_FROM=you@example.com          # From/envelope sender; falls back to SMTP_USERNAME

# --- AI drafting (optional: ADMIN-ONLY; omit to disable) ---
# Groq-powered "draft with AI" in the New-post editor (brief -> title/summary/
# slug/tags + Editor.js content, multi-model compare-and-pick). Enabled only
# when GROQ_API_KEY is set; otherwise the admin UI hides the panel and the
# /api/admin/{models,assist} endpoints return 503. The key is SERVER-SIDE ONLY
# (never sent to the browser or logged) and each call COSTS Groq API usage.
# GROQ_API_KEY=gsk_xxxxxxxx             # sensitive; from console.groq.com
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b  # selectable chat allowlist
# GROQ_MAX_MODELS=4                     # max models per Generate request (cost cap)

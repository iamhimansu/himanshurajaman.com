# Copy this file to .env.local (gitignored) and fill in the values, then run
# `make admin`. Keep values on their own lines, no spaces around `=`, and put
# comments on their own lines (not inline), since this file is sourced by sh.

# --- Admin / Google OAuth (required to enable the /admin CMS) ---
# Create an OAuth 2.0 "Web application" client in Google Cloud Console and add
# this authorized redirect URI: <BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# The single Google account allowed to administer the site. A valid Google
# login that is not this verified email is rejected.
ADMIN_EMAIL=you@example.com

# Session cookie encryption key, 32+ bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL. The OAuth redirect is <BASE_URL>/auth/callback.
BASE_URL=http://localhost:8080

# Secure cookies need HTTPS; keep false for local http, true in production.
COOKIE_SECURE=false

# --- Content source ---
# Local mode: you can sign in and browse the admin, but PUBLISHING IS DISABLED
# (there is no GitHub target). Good for trying the UI.
CONTENT_SOURCE=local
CONTENT_LOCAL_DIR=./sample-content

# To PUBLISH (write posts/resume to the content repo), comment out the two
# CONTENT_* lines above and use these instead, with a fine-grained PAT scoped
# to the content repo with Contents: Read AND Write:
# CONTENT_SOURCE=github
# CONTENT_REPO=iamhimansu/content.himanshurajaman.com
# CONTENT_REF=main
# GITHUB_TOKEN=github_pat_xxxxxxxx
# Optional push-to-resync webhook: same secret as the content repo's GitHub
# webhook (content-type application/json; event: push). Empty = disabled (404).
# GITHUB_WEBHOOK_SECRET=

# --- Contact form (optional: omit to disable the public contact form) ---
# Fail-safe like the admin block: POST /api/contact + the home-page form are
# enabled when EITHER Resend (RESEND_API_KEY) OR a full SMTP set is configured.
# Otherwise the endpoint returns 503 and the site shows a mailto: fallback.
#
# Option A — Resend HTTP API (recommended; works on Render free, which BLOCKS
# outbound SMTP). CONTACT_FROM must be an address on a domain you verified in
# the Resend dashboard; CONTACT_TO falls back to ADMIN_EMAIL.
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM=contact@himanshurajaman.com
# CONTACT_TO=you@example.com
#
# Option B — SMTP with STARTTLS (works locally; BLOCKED on Render free). From
# falls back to SMTP_USERNAME.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=
# CONTACT_TO=you@example.com
# CONTACT_FROM=you@example.com

# Optional: override the HTTP port (default 8080).
# PORT=8080
